# Session signing. Set a long random string in production.
SESSION_SECRET=replace-me

# Pepper for every derived identifier: human ids, ballot keys, thread voice keys.
# Required in production — the app refuses to start without it, because the
# fallback is a public constant and would make the store trivially re-linkable.
# Falls back to SESSION_SECRET if unset.
#
# WARNING: rotating this orphans every existing human. They stay verified with
# World ID but come back as a new person with no Surrogates. Treat it like a
# database encryption key, not a config value.
#   openssl rand -hex 32
ANON_ID_PEPPER=

# Where the MVP JSON store is written. Defaults to ./data/store.json.
# Point this at a mounted volume in a deploy, or a throwaway path for a demo.
ANON_STORE_PATH=

# Mini App app_id from the World Developer Portal (optional in demo mode).
NEXT_PUBLIC_WORLD_APP_ID=app_staging_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# World ID 4.0 credentials. Leave empty to use demo humans locally.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
RP_SIGNING_KEY=
WORLD_ID_ACTION=anon-verify

# The public signer address the Developer Portal shows for your signing key.
# Optional: /selftest uses it to confirm RP_SIGNING_KEY is the key, not the
# address.
WORLD_ID_SIGNER_ADDRESS=
